    x:Class="SPTarkov.Launcher.App"
    RequestedThemeVariant="Dark"
>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SPT.Launcher/Theme/Launcher.axaml" />
    </Application.Styles>
</Application>
