@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject StateHelper StateHelper
@inject ConfigHelper ConfigHelper
@inject LocaleHelper LocaleHelper
@inject HttpHelper HttpHelper
@inject SPTarkov.Core.Runtime.OfflineRuntime OfflineRuntime
@inject ISnackbar Snackbar
@inject ILogger<ServerCardComponent> Logger
@implements IDisposable

<MudItem md="4">
    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column flex-none gap-2 border-2 border-solid mud-border-lines-default card-container cursor-pointer card-interactive" @onclick="RunLoginTask">

        <div class="d-flex align-center justify-space-between no-select">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Inherit" Style="@ServerIconStyle" Class="no-pointers"/>
                @if (Server.Locked)
                {
                    <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" Text="@(LocaleHelper.Get("server_card_protect"))">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="card-lock"/>
                    </MudTooltip>
                }
                else
                {
                    <div class="d-flex align-center gap-1 card-actions" @onclick:stopPropagation="true">
                        <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" ShowOnHover="true" ShowOnFocus="false" ShowOnClick="false" Text="@(LocaleHelper.Get("server_card_edit"))">
                            <MudIconButton Icon="@Icons.Material.Filled.Build" Color="Color.Inherit" Size="Size.Small" OnClick="RunEditTask"/>
                        </MudTooltip>
                        <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" ShowOnHover="true" ShowOnFocus="false" ShowOnClick="false" Text="@(LocaleHelper.Get("server_card_delete"))">
                            <MudIconButton Class="card-action-delete" Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit" Size="Size.Small" OnClick="RunDeleteTask"/>
                        </MudTooltip>
                    </div>
                }
            </div>
            <div class="card-status @StatusModifier() no-pointers">
                <span class="card-status-dot"></span>
                <span class="card-status-label">@StatusLabel()</span>
            </div>
        </div>

        <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">@(LocaleHelper.Get("server_card_name"))</MudText>
        <MudText Typo="Typo.h6" Class="text-overflow no-pointers no-select">@Server.Name</MudText>

        <MudDivider DividerType="DividerType.FullWidth"/>

        <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">@(LocaleHelper.Get("server_card_address"))</MudText>
        <MudText Typo="Typo.h6" Class="text-overflow card-mono no-pointers no-select">@Server.IpAddress</MudText>

    </MudPaper>
</MudItem>

@code {
    [Parameter] public Server Server { get; set; } = default!;

    [Parameter] public List<Server> ServerList { get; set; } = [];

    [Parameter] public EventCallback<List<Server>> ServerListChanged { get; set; }

    private enum ServerStatus
    {
        Checking,
        Online,
        Offline,
    }

    private static readonly TimeSpan StatusProbeTimeout = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan StatusPollInterval = TimeSpan.FromSeconds(15);

    private ServerStatus _status = ServerStatus.Checking;

    // Cancelled on dispose to stop the status poll and any in-flight probe.
    private readonly CancellationTokenSource _disposeCts = new();

    // Deterministic per-server tint for the header glyph, hashed from name and address.
    private string ServerIconStyle => $"color: {ModPageVisual.GetColor($"{Server.Name}|{Server.IpAddress}")};";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = PollStatusAsync(_disposeCts.Token);
    }

    // Probe now and every StatusPollInterval thereafter until the component is disposed.
    private async Task PollStatusAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(StatusPollInterval);

        try
        {
            do
            {
                await RefreshStatusAsync(token);
            } while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException)
        {
            // Disposed... stop polling.
        }
    }

    private async Task RefreshStatusAsync(CancellationToken token)
    {
        using var probeCts = CancellationTokenSource.CreateLinkedTokenSource(token);
        probeCts.CancelAfter(StatusProbeTimeout);

        var pin = Server.CertificateSha256;
        if (pin is null && SPTarkov.Core.Runtime.ServerEndpoint.IsValid(Server.IpAddress) &&
            SPTarkov.Core.Runtime.ServerEndpoint.Normalize(Server.IpAddress) == OfflineRuntime.BoundBackendUrl)
            pin = OfflineRuntime.VerifiedBackendTlsSha256;
        var online = await HttpHelper.PingServerAsync(Server.IpAddress, probeCts.Token, pin);
        _status = online ? ServerStatus.Online : ServerStatus.Offline;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Component is gone; nothing to update. Shame.
        }
    }

    private string StatusLabel()
    {
        return _status switch
        {
            ServerStatus.Online => LocaleHelper.Get("server_card_status_online"),
            ServerStatus.Offline => LocaleHelper.Get("server_card_status_offline"),
            _ => LocaleHelper.Get("server_card_status_checking"),
        };
    }

    private string StatusModifier()
    {
        return _status switch
        {
            ServerStatus.Online => "card-status--online",
            ServerStatus.Offline => "card-status--offline",
            _ => "card-status--checking",
        };
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private async Task RunEditTask()
    {
        var param = new DialogParameters
        {
            {
                "Server", Server with { }
            }
        };

        var dialog = await DialogService.ShowAsync<ServerEditDialog>("ServerEditDialog", param, ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false && result.Data is Server edited)
        {
            var oldValid = SPTarkov.Core.Runtime.ServerEndpoint.IsValid(Server.IpAddress);
            var endpointChanged = !oldValid || SPTarkov.Core.Runtime.ServerEndpoint.Normalize(Server.IpAddress) != edited.IpAddress || Server.CertificateSha256 != edited.CertificateSha256;
            if (endpointChanged && oldValid && OfflineRuntime.BoundBackendUrl == SPTarkov.Core.Runtime.ServerEndpoint.Normalize(Server.IpAddress) && !await ConfirmDisconnect()) return;
            var serverToChange = ServerList.FirstOrDefault(x => x.ServerId == Server.ServerId);

            if (serverToChange != null)
            {
                serverToChange.Name = edited.Name;
                serverToChange.IpAddress = edited.IpAddress;
                serverToChange.CertificateSha256 = edited.CertificateSha256;
            }

            ConfigHelper.SetServers(ServerList);
            await ServerListChanged.InvokeAsync(ServerList);
        }
    }

    private async Task RunLoginTask()
    {
        if (!SPTarkov.Core.Runtime.ServerEndpoint.IsValid(Server.IpAddress)) { Snackbar.Add("Edit this server and enter a valid hostname and port.", Severity.Warning); return; }
        if (OfflineRuntime.RequiresServerDisconnect(Server.IpAddress, Server.CertificateSha256) && !await ConfirmDisconnect()) return;
        if (StateHelper.SelectedServer != null)
        {
            StateHelper.LogoutAndDispose();
        }

        var param = new DialogParameters
        {
            {
                "Server", Server
            }
        };

        var dialog = await DialogService.ShowAsync<ServerLoginDialog>("ServerLoginDialog", param, ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            ConfigHelper.SetStartupServerId(Server.ServerId);
            StateHelper.SetAllowServerPage(true);

            NavigationManager.NavigateTo("/Profiles");
        }
    }

    private async Task RunDeleteTask()
    {
        var param = new DialogParameters
        {
            {
                "Server", Server
            }
        };

        var dialog = await DialogService.ShowAsync<ServerRemoveDialog>("ServerRemoveDialog", param, ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            if (SPTarkov.Core.Runtime.ServerEndpoint.IsValid(Server.IpAddress) && OfflineRuntime.BoundBackendUrl == SPTarkov.Core.Runtime.ServerEndpoint.Normalize(Server.IpAddress) && !await ConfirmDisconnect()) return;
            ServerList.Remove(Server);
            await ServerListChanged.InvokeAsync(ServerList);

            ConfigHelper.SetServers(ServerList);
        }
    }

    private async Task<bool> ConfirmDisconnect()
    {
        var accepted = await DialogService.ShowMessageBoxAsync("Disconnect current server?", "Disconnect before changing the server address or trusted certificate.", yesText: "Disconnect", cancelText: "Cancel");
        if (accepted != true) return false;
        try
        {
            await OfflineRuntime.ReleaseAsync(_disposeCts.Token);
            StateHelper.LogoutAndDispose();
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Server change disconnect refused");
            Snackbar.PersistentError("The server could not be disconnected. Finish the game or reload pending server settings, then try again.", Severity.Warning);
            return false;
        }
    }

}
