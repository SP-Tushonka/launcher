@inherits SettingComponentBase

<MudContainer Class="pa-0">
    <SettingSwitchComponent Switch="@(Enabled)" OptionName="@(LocaleHelper.Get("setting_set_game_path"))" SwitchFunc="SetEnabled" />
    <MudLink Color="Color.Default" Underline="Underline.None" Disabled="!Enabled" Class="@(GetLinkClasses())">
        <MudTextField T="string" Value="@NewValue"
                    ValueChanged="@OnNewValueChanged"
                    Label="@(LocaleHelper.Get("setting_game_path"))"
                    Variant="Variant.Outlined" Immediate="true"
                    Margin="Margin.Dense" Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Folder"
                    AdornmentColor="Color.Info" OnAdornmentClick="SetFolderPath"
                    Error="@(HasError)" Disabled="!Enabled" />
        <MudIconButton Color="@(IsSaved ? Color.Default : Color.Success)" Icon="@Icons.Material.Filled.Save"
                    Disabled="IsSaved || !Enabled" OnClick="Save"/>
    </MudLink>
</MudContainer>
@if (AddDiv)
{
    <MudDivider DividerType="DividerType.Middle" Class="ma-0"/>
}

@code {

    [Parameter]
    public bool Enabled { get; set; }

    // Compared against the config rather than a cached copy, so the button cant claim unsaved edits that arent there.
    private bool IsSaved => NewValue == ConfigHelper.GetConfig().GamePath;

    protected override async Task OnInitializedAsync()
    {
        Enabled = ConfigHelper.GetConfig().EnableGamePath;
        NewValue = ConfigHelper.GetGamePath(); 
        HasError = !ValidateValue();

        await base.OnInitializedAsync();
    }

    protected override string GetLinkClasses()
    {
        var classes = new CssBuilder()
            .AddClass("d-flex")
            .AddClass("justify-center")
            .AddClass("align-center")
            .AddClass("py-2")
            .AddClass("pl-5");

        if (Enabled)
        {
            classes.AddClass("cursor-pointer").AddClass("setting-on-hover");
        }

        return classes.Build();
    }

    protected override async Task SaveValue()
    {
        ConfigHelper.SetGamePath(NewValue);
    }

    protected override bool ValidateValue()
    {
        return ConfigHelper.IsGamePathValid(NewValue);
    }

    private Task SetEnabled()
    {
        Enabled = !Enabled;

        ConfigHelper.SetEnableGamePath(Enabled);
        NewValue = ConfigHelper.GetGamePath();
        HasError = !ValidateValue();

        return Task.CompletedTask;
    }

}