@inherits SettingComponentBase

<MudContainer Class="pa-0">
    <MudLink Color="Color.Default" Underline="Underline.None" Disabled="Disabled" Class="@(GetLinkClasses())">
        <MudTextField @bind-Value="NewValue" Label="@(LocaleHelper.Get("linux_launch_settings"))" Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" Placeholder="MANGOHUD=1"/>
        <MudIconButton Color="@(IsSaved ? Color.Default : Color.Success)" Icon="@Icons.Material.Filled.Save" Disabled="@(IsSaved)" OnClick="OnTextSaved" />
    </MudLink>
</MudContainer>
@if (AddDiv)
{
    <MudDivider DividerType="DividerType.Middle" Class="ma-0"/>
}

@code {

    // Compared against the config rather than a cached copy, so the button cant claim unsaved edits that arent there.
    private bool IsSaved => NewValue == ConfigHelper.GetConfig().LinuxSettings.LaunchSettings;

    protected override async Task OnInitializedAsync()
    {
        NewValue = ConfigHelper.GetConfig().LinuxSettings.LaunchSettings;

        await base.OnInitializedAsync();
    }

    private void OnTextSaved()
    {
        if (!IsSaved)
        {
            ConfigHelper.SetLinuxLaunchSettings(NewValue);
            StateHasChanged();
        }
    }

}
