<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:SPTarkov.Launcher.Controls"
    xmlns:v="using:SPTarkov.Launcher.Views"
    x:Class="SPTarkov.Launcher.MainWindow"
    Icon="avares://SPT.Launcher/Assets/spt-logo.ico"
    Width="1054"
    Height="521"
    MinWidth="1054"
    MinHeight="521"
    WindowStartupLocation="CenterScreen"
    TextOptions.TextRenderingMode="Antialias"
>
    <Panel>
        <Panel x:Name="PageLayer">
            <Image x:Name="PageBackground" Stretch="Fill" />
            <DockPanel>
                <v:NavRail x:Name="Rail" x:FieldModifier="public" DockPanel.Dock="Left" />
                <ContentControl x:Name="PageHost" />
            </DockPanel>
            <v:ModPagesPanel x:Name="ModPages" Margin="56,0,0,0" />
        </Panel>

        <Panel x:Name="DialogLayer" IsVisible="False">
            <Image x:Name="DialogBackdrop" Stretch="Fill" />
            <ContentControl x:Name="DialogHost" Margin="0,32" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>

        <c:ToastHost />
    </Panel>
</Window>
