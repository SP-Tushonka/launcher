@page "/Profile"
@implements IDisposable
@using SPTarkov.Core.Runtime

@inject StateHelper StateHelper
@inject GameHelper GameHelper
@inject SPTarkov.Core.Runtime.OfflineRuntime OfflineRuntime
@inject SPTarkov.Core.Connections.IConnectionRestrictionService ConnectionRestrictionService
@inject ILogger<Profile> Logger
@inject NavigationManager NavigationManager
@inject LocaleHelper LocaleHelper
@inject ConfigHelper ConfigHelper
@inject ISnackbar Snackbar
@inject HttpHelper HttpHelper
@inject IDialogService DialogService

<MudContainer Class="px-4 my-2" MaxWidth="MaxWidth.Large">
    @if (!string.IsNullOrEmpty(_runtimeStatus)) { <MudText role="status">@_runtimeStatus</MudText> }
    @if (OfflineRuntime.RecoveryRequired && !_gameTaskActive)
    {
        <MudAlert Severity="Severity.Warning">Select Stop game and recover before changing profiles or starting again.</MudAlert>
        <MudButton OnClick="RecoverGame" Disabled="@(_recovering || _environmentBusy || _wipeDialogActive || _exitingAfterStart || OfflineRuntime.EnvironmentChangeUncertain)" Variant="Variant.Filled" Color="Color.Warning">Stop game and recover</MudButton>
    }
    <MudContainer Class="pa-0 mb-4 d-flex flex-row justify-space-between relative">
        <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Disabled="@_buttonDisabled" Variant="Variant.Filled" Color="Color.Dark" OnClick="ReturnToProfiles" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Medium" IconColor="Color.Error">@(LocaleHelper.Get("profile_logout"))</MudButton>
        <div class="profile-name-overlay d-flex flex-row align-center gap-2 no-pointers no-select">
            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Style="@ProfileIconStyle"/>
            <MudText Typo="Typo.h5">@(SelectedMiniProfile.Nickname == "unknown" ? LocaleHelper.Get("profile_no_character") : SelectedMiniProfile.Nickname)</MudText>
        </div>
        <MudSpacer/>
        @if (ShowWipeCheckbox)
        {
            <MudPaper Elevation="2" Class="px-2 py-0 d-flex flex-row justify-center align-center gap-8 mud-background-gray border-2 border-solid mud-border-lines-default card-container mr-2 wipe-control">
                <MudCheckBox T="bool" Value="CheckboxForWipe" ValueChanged="OnWipeCheckboxChanged" Class="wipe-checkbox" Disabled="@_buttonDisabled">@(LocaleHelper.Get("profile_wipe_checkbox"))</MudCheckBox>
            </MudPaper>
        }
        <MudButton Class="@($"mud-button-border-copy border-2 border-solid mud-button-inner-text-copy{(CheckboxForWipe ? " danger-button" : "")}")" Disabled="@_buttonDisabled" Variant="Variant.Filled" Color="Color.Dark" OnClick="StartGameTask" EndIcon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" IconColor="@(CheckboxForWipe ? Color.Inherit : Color.Success)">@(CheckboxForWipe ? LocaleHelper.Get("profile_wipe_and_start") : LocaleHelper.Get("profile_start_game"))</MudButton>
    </MudContainer>
    @if (OfflineRuntime.EnvironmentChangeUncertain)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">Reload server settings to verify the previous change.</MudAlert>
    }
    <EventSettingsPanel Disabled="@_environmentPanelDisabled" BusyChanged="OnEnvironmentBusyChanged"/>
    <MudContainer Class="pa-0 mb-4 d-flex flex-row gap-4 justify-center">
        <ProfileCardComponent MiniProfile="SelectedMiniProfile" HideDeleteButton="true"/>
        <ProfileStatsComponent MiniProfile="SelectedMiniProfile"/>
    </MudContainer>
    <MudContainer Class="pa-0 mb-4">
        <MudPaper Elevation="2" Class="pa-2 px-2 d-flex flex-row justify-center gap-8 mud-background-gray border-2 border-solid mud-border-lines-default card-container">
            <MudText Typo="Typo.h6">₽: @SelectedMiniProfile.ProfileCurrency.Roubles</MudText>
            <MudText Typo="Typo.h6">$: @SelectedMiniProfile.ProfileCurrency.Dollars</MudText>
            <MudText Typo="Typo.h6">€: @SelectedMiniProfile.ProfileCurrency.Euros</MudText>
            <MudText Typo="Typo.h6">GP: @SelectedMiniProfile.ProfileCurrency.GP</MudText>
        </MudPaper>
    </MudContainer>
    <MudContainer Class="pa-0 mb-4 d-flex flex-row gap-4 justify-center">
        <ProfileLevelComponent CurrentExp="SelectedMiniProfile.CurrentExp" CurrentLevel="SelectedMiniProfile.CurrentLevel" NeededExp="SelectedMiniProfile.NextLevel"/>
    </MudContainer>
    @if (BundleProgressState is not null)
    {
        <MudContainer Class="pa-0 mb-4">
            <MudPaper Elevation="2" Class="pa-3 mud-background-gray border-2 border-solid mud-border-lines-default card-container">
                <MudText Typo="Typo.subtitle2" Class="mb-1">@(LocaleHelper.Get("profile_page_task_4")): @BundleProgressState.Current / @BundleProgressState.Total</MudText>
                <MudProgressLinear Color="Color.Success" Value="@BundleProgressState.Percentage" Class="my-1"/>
                @if (BundleProgressState.IsDownloading)
                {
                    <MudText Typo="Typo.caption">@BundleProgressState.BundleName</MudText>
                    <MudText Typo="Typo.caption" Class="d-block">@BundleProgressState.DownloadSpeed | @BundleProgressState.FileSizeInfo</MudText>
                }
            </MudPaper>
        </MudContainer>
    }
</MudContainer>

@code {
    private bool CheckboxForWipe { get; set; }
    private MiniProfile SelectedMiniProfile { get; set; } = default!;
    // Derive availability from every owner so one completed task cannot unlock another task's controls.
    private bool _environmentPanelDisabled => _environmentBusy || _gameTaskActive || _recovering || _wipeDialogActive ||
        _exitingAfterStart || OfflineRuntime.RecoveryRequired;
    private bool _buttonDisabled => _environmentPanelDisabled || OfflineRuntime.EnvironmentChangeUncertain;
    private bool _environmentBusy;
    private bool _wipeDialogActive;
    private bool _exitingAfterStart;
    private bool _gameTaskActive;
    private bool _recovering;

    private BundleProgress? BundleProgressState { get; set; }
    private bool ShowWipeCheckbox => !SelectedMiniProfile.Wipe;

    // Deterministic per-profile tint for the name glyph, hashed from the username.
    private string ProfileIconStyle => $"color: {ModPageVisual.GetColor(SelectedMiniProfile.Username)};";

    protected override void OnInitialized()
    {
        Launcher.ExitCancelled += OnExitCancelled;
        if (StateHelper.SelectedProfile is null)
        {
            NavigationManager.NavigateTo("/ServerPageWrapper/false");
            return;
        }

        SelectedMiniProfile = StateHelper.SelectedProfile;
        Logger.LogDebug("Selected profile: {Username}", SelectedMiniProfile?.Username);

        base.OnInitialized();
    }

    private void OnExitCancelled() => _ = InvokeAsync(() =>
    {
        _exitingAfterStart = false;
        _runtimeStatus = string.Empty;
        UpdateNavigationAvailability();
        StateHasChanged();
    });

    public void Dispose() => Launcher.ExitCancelled -= OnExitCancelled;

    private async Task OnWipeCheckboxChanged(bool value)
    {
        if (_buttonDisabled) return;
        if (!value)
        {
            CheckboxForWipe = false;
            return;
        }

        _wipeDialogActive = true;
        UpdateNavigationAvailability();
        try
        {
            var dialogParams = new DialogParameters { { "MiniProfile", SelectedMiniProfile } };
            var dialog = await DialogService.ShowAsync<ProfileWipeDialog>(LocaleHelper.Get("profile_wipe_confirm_title"), dialogParams, ConfigHelper.DialogOptions);
            var result = await dialog.Result;
            if (!_environmentBusy && !_gameTaskActive && !_recovering && !_exitingAfterStart &&
                !OfflineRuntime.RecoveryRequired && !OfflineRuntime.EnvironmentChangeUncertain)
                CheckboxForWipe = result?.Canceled is false;
        }
        finally
        {
            _wipeDialogActive = false;
            UpdateNavigationAvailability();
            StateHasChanged();
        }
    }

    private Task OnEnvironmentBusyChanged(bool busy)
    {
        // Check synchronously before the child starts IPC, including events queued before a disabled render.
        if (busy && (_gameTaskActive || _recovering || _wipeDialogActive || _exitingAfterStart || OfflineRuntime.RecoveryRequired))
            throw new InvalidOperationException("Finish the current profile operation before changing server settings.");
        _environmentBusy = busy;
        UpdateNavigationAvailability();
        return Task.CompletedTask;
    }

    private void UpdateNavigationAvailability() => StateHelper.SetAllowNavigation(!_buttonDisabled);

    /// <summary>
    /// Wrap the StartGame method to easily control navigation.
    /// </summary>
    private async Task StartGameTask()
    {
        if (_buttonDisabled) return;
        _gameTaskActive = true;
        UpdateNavigationAvailability();

        try
        {
            await StartGame();
            if (!_exitingAfterStart && !OfflineRuntime.RecoveryRequired) await RefreshProfiles();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Offline Play failed");
            Snackbar.PersistentError(RuntimeUserMessages.Starting(OfflineRuntime.RecoveryRequired));
        }
        finally
        {
            _gameTaskActive = false;
            if (!_exitingAfterStart)
            {
                _runtimeStatus = string.Empty;
                BundleProgressState = null;
                CheckboxForWipe = false;
                if (ConfigHelper.GetConfig().MinimizeOnLaunch)
                    Launcher.App.MainWindow.SetMinimized(false);
            }
            UpdateNavigationAvailability();
        }
    }

    private async Task RecoverGame()
    {
        if (_environmentBusy || _gameTaskActive || _recovering || _wipeDialogActive || _exitingAfterStart ||
            OfflineRuntime.EnvironmentChangeUncertain || !OfflineRuntime.RecoveryRequired) return;
        _recovering = true;
        UpdateNavigationAvailability();
        _runtimeStatus = "Stopping game and verifying cleanup…";
        try
        {
            await OfflineRuntime.StopAsync(CancellationToken.None);
            await RefreshProfiles();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Offline game recovery failed");
            Snackbar.PersistentError(RuntimeUserMessages.RecoveryFailed);
        }
        finally
        {
            _recovering = false;
            _runtimeStatus = string.Empty;
            UpdateNavigationAvailability();
        }
    }

    private async Task RefreshProfiles()
    {
        Snackbar.Add(LocaleHelper.Get("profile_update_request"));
        if (await GetUpdatedProfiles())
        {
            // if this succeeded, we don't need to go further
            StateHasChanged();
            return;
        }

        if (await GetUpdatedProfile())
        {
            // if this succeeded, we don't need to go further
            StateHasChanged();
        }

        // if we get here, something fucked up
    }

    private async Task<bool> GetUpdatedProfile()
    {
        var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        try
        {
            var requestObject = new SPTLoginRequest
            {
                Username = SelectedMiniProfile.Username
            };

            var returnResult = await HttpHelper.GameServerPut<SPTProfileResponse>(Urls.Profile, requestObject, token.Token);
            var result = returnResult?.Response;

            if (result is null)
            {
                return false;
            }

            StateHelper.SelectedProfile = result;
            SelectedMiniProfile = StateHelper.SelectedProfile;

            token.Dispose();
            return true;
        }
        catch (Exception e)
        {
            Logger.LogError("Exception occured in updating profile: {e}", e);
            await token.CancelAsync();
            return false;
        }
    }

    private async Task<bool> GetUpdatedProfiles()
    {
        var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        try
        {
            var returnResult = await HttpHelper.GameServerGet<SPTProfilesResponse>(Urls.Profiles, token.Token);
            StateHelper.ProfileList = returnResult?.Response!;
            var result = returnResult?.Response;

            if (result is null || !result.Any())
            {
                return false;
            }

            var updatedProfile = StateHelper.ProfileList?.FirstOrDefault(x => x.ProfileId == SelectedMiniProfile.ProfileId);

            if (updatedProfile is null)
            {
                return false;
            }

            StateHelper.SelectedProfile = updatedProfile;
            SelectedMiniProfile = updatedProfile;

            token.Dispose();
            return true;
        }
        catch (Exception e)
        {
            Logger.LogError("Exception occured in updating profiles: {e}", e);
            await token.CancelAsync();
            return false;
        }
    }

    private string _runtimeStatus = string.Empty;

    private async Task StartGame()
    {
        var profileId = SelectedMiniProfile.ProfileId;
        var requireGameConnections = ConfigHelper.GetConfig().RequireGameConnections;
        var enableManagedHost = ConfigHelper.GetConfig().EnableManagedHost;
        try
        {
            if (requireGameConnections)
            {
                var connections = await ConnectionRestrictionService.ReadAsync(CancellationToken.None);
                if (!connections.Available || !connections.Enabled)
                    throw new InvalidOperationException(connections.Message ?? "Required game connection protection is not verified. Check Game settings before Play.");
            }
            await OfflineRuntime.PreflightAsync(ConfigHelper.GetGamePath(), CancellationToken.None, enableManagedHost: enableManagedHost);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Offline Play preflight refused");
            Snackbar.PersistentError(RuntimeUserMessages.PreparationFailed);
            return;
        }

        // initial snackbar.add is inside wipeprofile for this one
        if (CheckboxForWipe && !await WipeProfile())
        {
            var message = GameHelper.ErrorMessage;
            Snackbar.PersistentError($"{LocaleHelper.Get("profile_unable_wipe")}: {message}");
            return;
        }

        if (ConfigHelper.GetConfig().ClearCacheOnLaunch && !await ClearCache())
        {
            var message = GameHelper.ErrorMessage;
            Snackbar.PersistentError($"{LocaleHelper.Get("profile_unable_clear")}: {message}");
            return;
        }

        Snackbar.Add(LocaleHelper.Get("profile_page_task_4"));
        BundleProgressState = new BundleProgress();

        var bundleProgress = new Progress<BundleProgress>(state =>
        {
            BundleProgressState = state;
            InvokeAsync(StateHasChanged);
        });

        var bundlesAcquired = await GameHelper.AcquireBundles(bundleProgress, CancellationToken.None);
        BundleProgressState = null;
        StateHasChanged();

        if (!bundlesAcquired)
        {
            var message = GameHelper.ErrorMessage;
            Snackbar.PersistentError($"{LocaleHelper.Get("profile_page_task_4_fail")}: {message}");
            return;
        }

        Snackbar.Add(LocaleHelper.Get("profile_page_task_3"));

        try
        {
            await OfflineRuntime.LaunchWithRecoveryAsync(profileId,
                ConfigHelper.GetGamePath(), CancellationToken.None,
                new Progress<string>(message => { _runtimeStatus = message; _ = InvokeAsync(StateHasChanged); }), requireGameConnections: requireGameConnections, enableManagedHost: enableManagedHost);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Game start failed");
            Snackbar.PersistentError(RuntimeUserMessages.Starting(OfflineRuntime.RecoveryRequired));
            return;
        }

        // If enabled, remember this server/profile so the next launcher startup can auto-connect straight to the profile page.
        if (ConfigHelper.GetConfig().AutoConnectLastProfile && StateHelper.SelectedServer is not null && StateHelper.SelectedProfile is not null)
        {
            ConfigHelper.SetPreferredProfile(StateHelper.SelectedServer.ServerId, StateHelper.SelectedProfile.ProfileId);
        }

        if (ConfigHelper.GetConfig().CloseOnGameStart)
        {
            // The independent runtime retains the game/backend lease after this UI exits.
            _exitingAfterStart = true;
            Launcher.RequestExit();
            return;
        }
        if (ConfigHelper.GetConfig().MinimizeOnLaunch) Launcher.App.MainWindow.SetMinimized(true);
        try { await OfflineRuntime.MonitorAsync(CancellationToken.None); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Game monitoring failed");
            Snackbar.PersistentError(RuntimeUserMessages.MonitoringFailed);
        }
    }

    private void ReturnToProfiles()
    {
        if (_buttonDisabled) return;
        StateHelper.SetSelectedProfile(null);
        NavigationManager.NavigateTo("/ServerPageWrapper/false");
    }

    private async Task<bool> WipeProfile()
    {
        if (_environmentBusy || _recovering || _wipeDialogActive || _exitingAfterStart ||
            OfflineRuntime.RecoveryRequired || OfflineRuntime.EnvironmentChangeUncertain) return false;
        Snackbar.Add(LocaleHelper.Get("profile_wipe"));
        var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        try
        {
            var wipeRequest = new SPTRegisterRequest
            {
                Edition = SelectedMiniProfile.Edition,
                Username = SelectedMiniProfile.Username
            };

            var returnResult = await HttpHelper.GameServerPut<SPTWipeResponse>(Urls.Wipe, wipeRequest, token.Token);

            if (returnResult is null)
            {
                return false;
            }

            StateHelper.ProfileList = returnResult.Profiles;
            var result = returnResult.Response;

            if (!result)
            {
                return false;
            }

            token.Dispose();
            return true;
        }
        catch (Exception)
        {
            await token.CancelAsync();
            return false;
        }
    }

    private async Task<bool> ClearCache()
    {
        Snackbar.Add(LocaleHelper.Get("profile_clear"));
        if (Directory.Exists(Paths.SptAppDataFolder))
        {
            try
            {
                Directory.Delete(Paths.SptAppDataFolder, true);
            }
            catch (Exception e)
            {
                Logger.LogError("exception occured in clearing game cache: {e}", e);
            }
        }

        return true;
    }
}
