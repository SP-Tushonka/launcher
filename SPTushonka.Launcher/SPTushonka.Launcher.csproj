<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Build.props" />

  <PropertyGroup>
    <PackageId>SPTushonka.Launcher</PackageId>
    <RootNamespace>SPTarkov.Launcher</RootNamespace>
    <Authors>Single Player Tushonka</Authors>
    <Description>Single Player Tushonka Launcher project.</Description>
    <Copyright>Copyright (c) Single Player Tushonka 2026</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://sp-mod.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SP-Tushonka/launcher</RepositoryUrl>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SPT.Launcher</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/spt-logo.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SPTushonka.Core/SPTushonka.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/bg.jpg" />
    <AvaloniaResource Include="Assets/spt-logo.ico" />
    <AvaloniaResource Include="Assets/side_*.png" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <SptData Include="$(ProjectDir)../SPTushonka.Core/SPT_Data/**/*.*" />
  </ItemGroup>

  <Target Name="CopySptData" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="@(SptData);" DestinationFolder="$(ProjectDir)$(OutDir)SPT_Data/%(RecursiveDir)" />
  </Target>
  
  <Target Name="SPTBuildEvent" AfterTargets="Publish">
    <RemoveDir Directories="$(ProjectDir)../Build" />
    <MakeDir Directories="$(ProjectDir)../Build" />
    <Copy
      Condition="'$(RuntimeIdentifier)' == 'win-x64'"
      SourceFiles="$(PublishDir)SPT.Launcher.exe"
      DestinationFolder="$(ProjectDir)../Build"
    />
    <Copy
      Condition="'$(RuntimeIdentifier)' == 'linux-x64'"
      SourceFiles="$(PublishDir)SPT.Launcher"
      DestinationFiles="$(ProjectDir)../Build/SPT.Launcher.Linux"
    />
    <Copy SourceFiles="@(SptData)" DestinationFiles="@(SptData->'$(ProjectDir)../Build/SPT_Data/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
