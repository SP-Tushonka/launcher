@implements IAsyncDisposable
@inject SPTarkov.Core.Runtime.OfflineRuntime OfflineRuntime
@inject StateHelper StateHelper
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<RuntimeSessionMonitor> Logger

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _monitor;

    protected override void OnInitialized() => _monitor = MonitorAsync();

    private async Task MonitorAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (_lifetime.IsCancellationRequested || StateHelper.SelectedServer is null ||
                        !StateHelper.AllowNavigation || OfflineRuntime.RecoveryRequired) return;
                    var server = StateHelper.SelectedServer;
                    try { await OfflineRuntime.RenewIdleLeaseAsync(_lifetime.Token); }
                    catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
                    catch (Exception ex)
                    {
                        if (_lifetime.IsCancellationRequested || !OfflineRuntime.IdleLeaseLost ||
                            !ReferenceEquals(server, StateHelper.SelectedServer)) return;
                        Logger.LogWarning(ex, "Local runtime session renewal failed");
                        Snackbar.PersistentError(OfflineRuntime.RecoveryRequired
                            ? "The local server connection was lost. Close the game, then select Stop game and recover. Details are in the launcher log."
                            : "The local server connection was lost. Reconnect to Local Server. Details are in the launcher log.");
                        if (OfflineRuntime.RecoveryRequired)
                        {
                            StateHelper.SetAllowNavigation(false);
                            return;
                        }
                        StateHelper.LogoutAndDispose();
                        StateHelper.SetAllowServerPage(false);
                        StateHelper.SetAllowNavigation(true);
                        NavigationManager.NavigateTo("/");
                    }
                });
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        if (_monitor is not null) await _monitor;
        _lifetime.Dispose();
    }
}
