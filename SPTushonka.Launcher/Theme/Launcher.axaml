<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:SPTarkov.Launcher.Controls"
>
    <Styles.Resources>
        <FontFamily x:Key="RobotoFont">avares://SPT.Launcher/Assets/Fonts#Roboto</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Roboto Mono, monospace</FontFamily>

        <SolidColorBrush x:Key="TextPrimary" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="TextDisabled" Color="#42FFFFFF" />
        <SolidColorBrush x:Key="GlassFill" Color="#B319191F" />
        <SolidColorBrush x:Key="Lines" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="InputLines" Color="#4CFFFFFF" />
        <SolidColorBrush x:Key="DisabledFill" Color="#1EFFFFFF" />

        <BoxShadows x:Key="Elevation1">0 2 1 -1 #33000000, 0 1 1 0 #24000000, 0 1 3 0 #1F000000</BoxShadows>
        <BoxShadows x:Key="Elevation2">0 3 1 -2 #33000000, 0 2 2 0 #24000000, 0 1 5 0 #1F000000</BoxShadows>
        <BoxShadows x:Key="Elevation5">0 3 5 -1 #33000000, 0 5 8 0 #24000000, 0 1 14 0 #1F000000</BoxShadows>
        <BoxShadows x:Key="Elevation24">0 11 15 -7 #33000000, 0 24 38 3 #24000000, 0 9 46 8 #1F000000</BoxShadows>

