    </Styles.Resources>

    <Style Selector="c|GlassBorder.card">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{StaticResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lines}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BoxShadow" Value="{StaticResource Elevation2}" />
    </Style>
    <!-- Clickable cards lift on hover and bring their muted header actions to full opacity -->
    <Style Selector="c|GlassBorder.card.interactive">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="c|GlassBorder.card.info">
        <Setter Property="BoxShadow" Value="{StaticResource Elevation1}" />
    </Style>
    <Style Selector="c|GlassBorder.card.interactive:pointerover">
        <Setter Property="BorderBrush" Value="#80FFFFFF" />
        <Setter Property="BoxShadow" Value="0 6 20 0 #59000000" />
        <Setter Property="RenderTransform" Value="translate(0px, -2px)" />
    </Style>
    <Style Selector="StackPanel.actions">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <!-- A link card's domain and open-in-new icon brighten with the card -->
    <Style Selector="StackPanel.external > TextBlock">
        <Setter Property="Foreground" Value="#59FFFFFF" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="c|GlassBorder.card.interactive:pointerover StackPanel.external > TextBlock">
        <Setter Property="Foreground" Value="#B3FFFFFF" />
    </Style>
    <Style Selector="StackPanel.external > c|MaterialIcon">
        <Setter Property="Foreground" Value="#59FFFFFF" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="c|GlassBorder.card.interactive:pointerover StackPanel.external > c|MaterialIcon">
        <Setter Property="Foreground" Value="#B3FFFFFF" />
    </Style>
    <Style Selector="c|GlassBorder.card.interactive:pointerover StackPanel.actions">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.delete:pointerover c|MaterialIcon">
        <Setter Property="Foreground" Value="#EF5350" />
    </Style>

    <Style Selector="Arc.spinner">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Stroke" Value="#776BE7" />
        <Setter Property="StrokeThickness" Value="4.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="100" />
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Tooltips render inside the window so they can draw glass over the page. The setting is read from the control that owns the tip -->
    <Style Selector=":is(Control)">
        <Setter Property="ToolTip.ShouldUseOverlayLayer" Value="True" />
    </Style>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource RobotoFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="#27272F" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="LetterSpacing" Value="0.15" />
        <Setter Property="LineHeight" Value="20.02" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="19.92" />
        <Setter Property="LetterSpacing" Value="0.4" />
    </Style>
    <Style Selector="TextBlock.h6">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="32" />
    </Style>
    <Style Selector="TextBlock.body1">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="LetterSpacing" Value="0.4" />
    </Style>
    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="17.16" />
        <Setter Property="LetterSpacing" Value="0.48" />
    </Style>
    <Style Selector="TextBlock.button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="24.5" />
        <Setter Property="LetterSpacing" Value="0.4" />
    </Style>

    <Style Selector="Button.glass">
        <Setter Property="Height" Value="41" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <c:GlassBorder
                    Name="PART_Glass"
                    Background="{StaticResource GlassFill}"
                    BorderBrush="{StaticResource Lines}"
                    BorderThickness="2"
                    CornerRadius="4"
                    BoxShadow="{StaticResource Elevation2}"
                >
                    <!-- The disabled tint sits over the glass fill rather than replacing it -->
                    <Panel>
                        <Border Name="Tint" CornerRadius="2" />
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                        />
                    </Panel>
                </c:GlassBorder>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.glass:pointerover /template/ c|GlassBorder#PART_Glass">
        <Setter Property="Background" Value="#C2232329" />
    </Style>
    <Style Selector="Button.glass:disabled">
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
    </Style>
    <Style Selector="Button.glass:disabled /template/ c|GlassBorder#PART_Glass">
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.glass:disabled /template/ Border#Tint">
        <Setter Property="Background" Value="{StaticResource DisabledFill}" />
    </Style>
    <!-- Confirm button for destructive actions -->
    <Style Selector="Button.glass.danger">
        <Setter Property="Foreground" Value="Black" />
    </Style>
    <Style Selector="Button.glass.danger /template/ c|GlassBorder#PART_Glass">
        <Setter Property="Background" Value="#C62828" />
        <Setter Property="BorderBrush" Value="#7F1D1D" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>

    <Style Selector="c|GlassBorder.dialog">
        <Setter Property="Layer" Value="Dialog" />
        <Setter Property="Width" Value="444" />
        <Setter Property="Background" Value="{StaticResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Lines}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BoxShadow" Value="{StaticResource Elevation24}" />
    </Style>
    <!-- Tinted ring behind a dialog header icon. Each dialog sets its colour -->
    <Style Selector="Border.dialogIcon">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Grid.details">
        <Setter Property="ColumnSpacing" Value="32" />
        <Setter Property="RowSpacing" Value="4" />
    </Style>
    <Style Selector="Grid.details > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TextBox.outlined">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LetterSpacing" Value="0.15" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderForeground" Value="#99FFFFFF" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="#776BE7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.outlined /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.outlined:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.outlined:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="c|OutlinedField c|OutlineBorder, c|OutlinedSelect c|OutlineBorder">
        <Setter Property="Stroke" Value="{StaticResource InputLines}" />
    </Style>
    <Style Selector="c|OutlinedField TextBlock.helper, c|OutlinedSelect TextBlock.helper">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="c|OutlinedField.error c|OutlineBorder, c|OutlinedSelect.error c|OutlineBorder">
        <Setter Property="Stroke" Value="#F64E62" />
    </Style>
    <Style Selector="c|OutlinedField.error TextBlock#FloatingLabel, c|OutlinedField.error TextBlock.helper, c|OutlinedSelect.error TextBlock#FloatingLabel, c|OutlinedSelect.error TextBlock.helper">
        <Setter Property="Foreground" Value="#F64E62" />
    </Style>
    <Style Selector="c|OutlinedField:disabled, c|OutlinedSelect:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Input of OutlinedSelect, which draws the frame and label around it -->
    <Style Selector="ComboBox.outlined">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <DockPanel Background="Transparent" Margin="14,0,8,0">
                        <c:MaterialIcon
                            DockPanel.Dock="Right"
                            Data="{StaticResource IconArrowDropDown}"
                            Foreground="#80FFFFFF"
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                        />
                        <ContentPresenter
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding ItemTemplate}"
                            VerticalAlignment="Center"
                        />
                    </DockPanel>
                    <Popup
                        Name="PART_Popup"
                        ShouldUseOverlayLayer="True"
                        IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                        Placement="BottomEdgeAlignedLeft"
                        IsLightDismissEnabled="True"
                        MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                        x:DataType="ComboBox"
                    >
                        <Border
                            Background="#F219191F"
                            BorderBrush="{StaticResource Lines}"
                            BorderThickness="1"
                            CornerRadius="4"
                            BoxShadow="{StaticResource Elevation5}"
                            Padding="0,8"
                        >
                            <ScrollViewer MaxHeight="192">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBox.outlined ComboBoxItem">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="Button.text">
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="Foreground" Value="#776BE7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.text:pointerover">
        <Setter Property="Background" Value="#14776BE7" />
    </Style>

    <!-- A settings row that toggles as a whole, with the switch drawn on its right -->
    <Style Selector="ToggleButton.setting">
        <Setter Property="Padding" Value="20,8,0,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <Panel DockPanel.Dock="Right" Width="58" Height="38">
                            <Border Name="Track" Width="34" Height="14" CornerRadius="9" Background="#ADADB1" Opacity="0.48" />
                            <Border
                                Name="Thumb"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Margin="9,0,0,0"
                                Background="#FAFAFA"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RenderTransform="none"
                                BoxShadow="{StaticResource Elevation1}"
                            >
                                <Border.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Panel>
                        <ContentPresenter Name="Label" Content="{TemplateBinding Content}" VerticalAlignment="Center">
                            <ContentPresenter.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="FontSize" Value="16" />
                                    <Setter Property="LineHeight" Value="24" />
                                </Style>
                            </ContentPresenter.Styles>
                        </ContentPresenter>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.setting:pointerover">
        <Setter Property="Background" Value="#33AAAAAA" />
    </Style>
    <Style Selector="ToggleButton.setting:checked /template/ Border#Track">
        <Setter Property="Background" Value="#1EC8A5" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="ToggleButton.setting:checked /template/ Border#Thumb">
        <Setter Property="Background" Value="#1EC8A5" />
        <Setter Property="RenderTransform" Value="translate(20px, 0px)" />
    </Style>
    <Style Selector="ToggleButton.setting:disabled">
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.setting:disabled /template/ ContentPresenter#Label">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="ToggleButton.setting:disabled /template/ Border#Track">
        <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="ToggleButton.setting:disabled /template/ Border#Thumb">
        <Setter Property="Background" Value="#9E9E9E" />
    </Style>

    <!-- Underlined drop-down -->
    <Style Selector="ComboBox.select">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="Transparent" BorderBrush="{StaticResource InputLines}" BorderThickness="0,0,0,1" Height="32">
                        <DockPanel>
                            <c:MaterialIcon
                                DockPanel.Dock="Right"
                                Data="{StaticResource IconArrowDropDown}"
                                Foreground="#80FFFFFF"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                            />
                            <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                VerticalAlignment="Center"
                                Margin="0,0,0,1"
                            />
                        </DockPanel>
                    </Border>
                    <Popup
                        Name="PART_Popup"
                        ShouldUseOverlayLayer="True"
                        IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                        Placement="BottomEdgeAlignedLeft"
                        IsLightDismissEnabled="True"
                        MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                        x:DataType="ComboBox"
                    >
                        <Border
                            Background="#F219191F"
                            BorderBrush="{StaticResource Lines}"
                            BorderThickness="1"
                            CornerRadius="4"
                            BoxShadow="{StaticResource Elevation5}"
                            Padding="0,8"
                        >
                            <ScrollViewer MaxHeight="192">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBox.select ComboBoxItem">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="Button.fab">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <c:GlassBorder
                    Background="#8027272F"
                    BorderBrush="{StaticResource Lines}"
                    BorderThickness="2"
                    CornerRadius="20"
                    BoxShadow="0 3 5 -1 #33000000, 0 6 10 0 #24000000, 0 1 18 0 #1F000000"
                >
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </c:GlassBorder>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
