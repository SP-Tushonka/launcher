<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:SPTarkov.Launcher.Controls"
    xmlns:l="using:SPTarkov.Launcher.Markup"
    x:Class="SPTarkov.Launcher.Views.ProfilesView"
>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="16,12,16,8" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="glass" Padding="12,6,16,6" Click="OnDisconnect">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:MaterialIcon
                            Data="{StaticResource IconArrowBack}"
                            Foreground="#F64E62"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Classes="button" Text="{l:Locale profiles_disconnect, Upper=True}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="glass" Padding="12,6,16,6" Click="OnCreate">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:MaterialIcon
                            Data="{StaticResource IconPersonAdd}"
                            Foreground="#0BBA83"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                        />
                        <TextBlock Classes="button" Text="{l:Locale profiles_create, Upper=True}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <UniformGrid x:Name="Cards" Columns="3" ColumnSpacing="24" RowSpacing="24" />

            <c:GlassBorder x:Name="EmptyState" Classes="card">
                <StackPanel Margin="0,48" Spacing="8" HorizontalAlignment="Center">
                    <c:MaterialIcon
                        Data="{StaticResource IconLinkOff}"
                        Foreground="{StaticResource TextSecondary}"
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                    />
                    <TextBlock
                        Classes="h6"
                        Text="{l:Locale profiles_connect_warning}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                    />
                </StackPanel>
            </c:GlassBorder>

            <!-- Username login for servers that list no profiles -->
            <c:GlassBorder x:Name="LoginCard" Classes="card" Width="380" Padding="24" Margin="0,32,0,0" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <Border x:Name="Avatar" Classes="dialogIcon" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center">
                        <c:MaterialIcon
                            x:Name="AvatarGlyph"
                            Data="{StaticResource IconPerson}"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                        />
                    </Border>
                    <c:OutlinedField x:Name="Username" Label="{l:Locale profile_login_username}" />
                    <Button x:Name="LoginButton" Classes="glass" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnLogin">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:MaterialIcon
                                Data="{StaticResource IconLogin}"
                                Foreground="#0BBA83"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                            />
                            <TextBlock Classes="button" Text="{l:Locale profile_login_confirm, Upper=True}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:GlassBorder>
        </StackPanel>
    </ScrollViewer>
</UserControl>
